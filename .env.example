SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_SECRET=your-jwt-secret
DEBUG=false
MAPBOX_TOKEN=                  # Optional — used for best-effort geocoding in the importer

# --- In-App Purchases (Apple / Google) ---
# All empty until store accounts exist; /purchases/validate answers 503
# validation_unavailable meanwhile (controlled failure, no crash).
# TODO(iap): App Store Connect → Users and Access → Integrations →
# In-App Purchase keys. Paste the .p8 PEM into APPLE_PRIVATE_KEY
# (literal \n escapes are fine).
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# TODO(iap): Play Console → API access → service account key.
# Raw JSON string or a path to the key file — both work.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# iOS bundle id / Android package name (same on both stores)
APP_BUNDLE_ID=com.bonvivant.app
